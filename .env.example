# Public site URL — used for canonical links, OG metadata, sitemap, robots.
# Example: https://sunscreentimer.app
NEXT_PUBLIC_SITE_URL=

# --- Google AdSense ---
# Leave EMPTY until you're approved by AdSense (typically 2–6 weeks
# after the site is live and indexed). When empty:
#   * production builds render nothing in ad slots
#   * dev builds render dashed-border placeholders so you can see positions
#
# Publisher ID — looks like "ca-pub-XXXXXXXXXXXXXXXX".
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Slot IDs — long numeric strings from the AdSense dashboard, one per unit.
# Homepage in-article slot (between the tool and the content section).
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
# Subpage in-article slot rendered at the end of the article body.
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=
# Subpage in-content slot rendered mid-article (between H2 sections).
NEXT_PUBLIC_ADSENSE_ARTICLE_MID_SLOT=
