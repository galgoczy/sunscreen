# Public site URL — used for canonical links, OG metadata, sitemap, robots.
# Example: https://sunscreen.zentopia.io
NEXT_PUBLIC_SITE_URL=

# --- Google Analytics 4 ---
# Defaults to G-77R7MWD4CL if unset. Set this to override in another env.
NEXT_PUBLIC_GA_ID=
# Set to "1" to enable GA in development. Default: disabled in dev.
NEXT_PUBLIC_GA_DEV=

# --- Google AdSense ---
# Leave EMPTY until you're approved by AdSense (typically 2–6 weeks
# after the site is live and indexed). When empty:
#   * "Ad space" placeholders render in every environment so you can see positions
#   * No adsbygoogle script is loaded — zero third-party network calls
#
# Publisher ID — looks like "ca-pub-XXXXXXXXXXXXXXXX".
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Slot IDs from the AdSense dashboard, one per unit:
NEXT_PUBLIC_ADSENSE_HOME_SLOT=               # Homepage · between tool and content
NEXT_PUBLIC_ADSENSE_HOME_MID_SLOT=           # Homepage · between guides and FAQ
NEXT_PUBLIC_ADSENSE_ARTICLE_TOP_SLOT=        # Article · top (above the fold on mobile)
NEXT_PUBLIC_ADSENSE_ARTICLE_MID_SLOT=        # Article · mid-content
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=            # Article · end-of-content
